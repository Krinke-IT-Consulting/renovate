# MEND_RNV_LICENSE_KEY
# Herkunft: Mensch (kostenloser Lizenzschlüssel für Mend Renovate CE, per Registrierung bei Mend).
# Zwingend für renovate-ce. Wird im Compose-Stack an renovate-ce durchgereicht und in Coolify
# als Variable der Compose-Ressource hinterlegt.
MEND_RNV_LICENSE_KEY=

# SCW_REGISTRY_SECRET_KEY
# Herkunft: Mensch (Scaleway-IAM-API-Key, nur Registry-Lesezugriff; Secret Key des Keys).
# Optional: ohne Wert startet Renovate CE ohne Registry-Zugangsdaten und aktualisiert nur
# Images aus öffentlichen Registries. Wird später im Compose-Stack an renovate-ce durchgereicht.
SCW_REGISTRY_SECRET_KEY=

# MEND_RNV_GITHUB_APP_ID
# Herkunft: Mensch (App-ID der GitHub App "Krinke IT Renovate", Seite der App in GitHub).
# Zwingend für renovate-ce und renovate-dashboard (dieselbe App, derselbe Wert).
MEND_RNV_GITHUB_APP_ID=

# MEND_RNV_GITHUB_APP_KEY
# Herkunft: Mensch (privater Schlüssel der GitHub App, PEM-Inhalt; in Coolify als mehrzeiliger Wert).
# Zwingend für renovate-ce und renovate-dashboard (dieselbe App, derselbe Wert).
MEND_RNV_GITHUB_APP_KEY=

# MEND_RNV_WEBHOOK_SECRET
# Herkunft: Selbst erzeugt (openssl rand -hex 32); derselbe Wert steht als Webhook-Secret in der GitHub App.
# Zwingend für renovate-ce. Siehe secrets-register.
MEND_RNV_WEBHOOK_SECRET=

# MEND_RNV_API_SERVER_SECRET
# Herkunft: Selbst erzeugt (openssl rand -hex 32); schützt die interne API von Renovate CE.
# Zwingend für renovate-ce (API aktiv) und renovate-dashboard (liest Jobs, stößt Läufe an). Siehe secrets-register.
MEND_RNV_API_SERVER_SECRET=

# POSTGRES_PASSWORD
# Herkunft: Selbst erzeugt (openssl rand -hex 32); Superuser-Passwort von Postgres, nur für Wartung.
# Zwingend für postgres. Siehe secrets-register.
POSTGRES_PASSWORD=

# RENOVATE_CE_DB_PASSWORD
# Herkunft: Selbst erzeugt (openssl rand -hex 32); Passwort der Rolle renovate_ce (Datenbank renovate_ce).
# Zwingend für postgres und renovate-ce. Siehe secrets-register.
RENOVATE_CE_DB_PASSWORD=

# DASHBOARD_DB_PASSWORD
# Herkunft: Selbst erzeugt (openssl rand -hex 32); Passwort der Rolle dashboard (Datenbank dashboard).
# Zwingend für postgres und renovate-dashboard (Compose setzt daraus DATABASE_URL). Siehe secrets-register.
DASHBOARD_DB_PASSWORD=

# AUTHELIA_SESSION_SECRET
# Herkunft: Selbst erzeugt (openssl rand -hex 32); signiert Authelia-Sitzungen.
# Zwingend für authelia. Siehe secrets-register.
AUTHELIA_SESSION_SECRET=

# AUTHELIA_STORAGE_ENCRYPTION_KEY
# Herkunft: Selbst erzeugt (openssl rand -hex 32); verschlüsselt die SQLite-Daten von Authelia (TOTP-Geheimnisse).
# Zwingend für authelia. Wechsel macht registrierte TOTP-Geräte unbrauchbar. Siehe secrets-register.
AUTHELIA_STORAGE_ENCRYPTION_KEY=

# AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET
# Herkunft: Selbst erzeugt (openssl rand -hex 32); JWT-Secret des (deaktivierten) Passwort-Resets, von Authelia dennoch verlangt.
# Zwingend für authelia. Siehe secrets-register.
AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET=

# AUTHELIA_INTERNAL_URL
# Herkunft: Konfiguration, kein Secret. Interne Adresse von Authelia, bei der das Dashboard jede
# Sitzung prüft. In Produktion fest in der Compose-Datei (http://renovate-authelia:9091), keine
# Coolify-Variable. Lokal in dashboard/.env.local (zwingend, sonst weist das Dashboard alles mit 403 ab).
AUTHELIA_INTERNAL_URL=

# DATABASE_URL
# Herkunft: Konfiguration. In Produktion setzt Compose den Wert aus DASHBOARD_DB_PASSWORD zusammen
# (keine Coolify-Variable). Lokal in dashboard/.env.local, z. B. gegen eine Wegwerf-Postgres:
# postgresql://postgres:dev@localhost:55432/dashboard
DATABASE_URL=

# RENOVATE_CE_API_URL
# Herkunft: Konfiguration. In Produktion fest in Compose: http://renovate-ce:8080 (internes Netz).
# Lokal in dashboard/.env.local.
RENOVATE_CE_API_URL=
